# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_s5
DB_USER=cloud_user
DB_PASSWORD=cloud_password

# API Configuration
NODE_ENV=development
API_PORT=3001
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRE_IN=24h

# Session Configuration
SESSION_MAX_ATTEMPTS=3
SESSION_LOCKOUT_DURATION=3600000

# Firebase Configuration (optional, for online mode)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Maps Configuration
MAPS_SERVER_URL=http://localhost:8080

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8100

# Swagger Documentation
SWAGGER_ENABLED=true
